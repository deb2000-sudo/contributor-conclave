# Local development only. Copy this file to .env (gitignored). Never commit .env.
# These credentials match docker-compose.yml. They are not production secrets.
# Production PostgreSQL is Google Cloud SQL; do not point local development at it.

# Connection string used by Prisma (prisma.config.ts) and the app (src/lib/db.ts).
# Local: Docker PostgreSQL from docker-compose.yml.
# Production: Cloud Run injects a different URL from Secret Manager. See ENGINEERING.md.
# Do not put a Cloud SQL password or instance name in this file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contributor_conclave"

# Connections this process may open. Default 5. Allowed range 1–10.
# Leave unset for local development. Set it on Cloud Run only when the
# Cloud SQL max_connections budget is sized for (instances × this value).
# DATABASE_POOL_MAX="5"

# Sessions are random tokens stored as hashes in PostgreSQL.
# Do not put session tokens, password hashes, GitHub tokens, or other secrets in NEXT_PUBLIC_ variables.

# GitHub personal access token. The server reads this as GITHUB_TOKEN.
# Every GitHub API call sends it from the server. The browser never receives it.
#
# Local setup:
# 1. Open GitHub → Settings → Developer settings → Personal access tokens.
# 2. Create a token that can read the user, repositories, and pull requests you need.
#    A fine-grained token with Public repositories (read-only) is enough for public data.
#    A classic token needs the public_repo scope. Add the repo scope only if private repositories must be read.
# 3. Copy .env.example to .env if you have not already, and set GITHUB_TOKEN to that token.
# 4. Restart `npm run dev`. Next.js reads .env when the server starts.
#
# Leave the value empty until you have a token. Do not commit .env.
# Do not rename this variable to NEXT_PUBLIC_GITHUB_TOKEN. NEXT_PUBLIC_ values are sent to the browser.
GITHUB_TOKEN=""

# Public footer profile. These are not secrets and not credentials.
# The repository does not include the author's name or profile URLs.
# Leave each value empty until you know it. Set them before deployment.
# The footer shows a profile link only when the value is an https profile URL.
# GitHub shape: https://github.com/USERNAME
# LinkedIn shape: https://www.linkedin.com/in/PROFILE
AUTHOR_NAME=""
AUTHOR_GITHUB_URL=""
AUTHOR_LINKEDIN_URL=""

# 32-byte key, base64-encoded, used to encrypt message bodies at rest.
# This is application-level storage encryption. It is not end-to-end encryption.
# Generate one locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Do not commit the value. Do not put it in a NEXT_PUBLIC_ variable.
MESSAGE_ENCRYPTION_KEY=""

# Commands (run from the repository root):
# npm run db:up        Start local PostgreSQL in Docker. Data is kept in a named volume.
# npm run db:down      Stop the database container. Data remains until the volume is removed.
# npm run db:validate  Check prisma/schema.prisma without touching the database.
# npm run db:generate  Generate the Prisma Client into src/generated (required after schema changes).
# npm run db:migrate   Create a migration from the schema and apply it to the local database.
# npm run db:deploy    Apply existing migrations only. Use this in production (Cloud SQL), not while authoring schema.
# npm run db:studio    Open Prisma Studio to inspect local tables in the browser.
# npm run dev          Start the Next.js development server (does not start PostgreSQL).
